# ==========================================================================
# CATALOG STUDIO - configuración lista para el PC que tiene la base de datos
# Uso:  copy .env.example .env   ->   php artisan key:generate   ->   php artisan migrate
# (Los valores ya son los del entorno confirmado: Laragon, MySQL 8.4 en el puerto 3307.)
# ==========================================================================

# ---------- Aplicación ----------
APP_NAME="Catalog Studio"
APP_ENV=local
# APP_KEY se genera con: php artisan key:generate  (NO copiar la clave de otro equipo)
APP_KEY=
APP_DEBUG=true
# URL con la que se abre la app (php artisan serve). Se usa para URLs de fotos (/storage/...) y enlaces de correo.
# Si usa Apache de Laragon cambie a p. ej. http://catalog_studio_laravel.test
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------- Logs ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Base de datos MySQL (no cambiar el puerto) ----------
# La BD "catalog_studio_laravel" debe existir (las migraciones crean las tablas, no la BD).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=catalog_studio_laravel
DB_USERNAME=root
DB_PASSWORD=

# ---------- Sesión, caché y colas (usan las tablas ya migradas: sessions, cache, jobs) ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Las fotos usan el disco "public" (requiere: php artisan storage:link)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Correo ----------
# "log": el correo de recuperación de contraseña se escribe en storage/logs/laravel.log
# (abrir ese archivo y copiar el enlace /restablecer-contrasena/...). Para correo real use smtp
# o Mailpit de Laragon: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@catalogstudio.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------- Integraciones ----------
# API externa de productos (módulo Importación)
DUMMYJSON_BASE_URL=https://dummyjson.com

# Sanctum: dominios desde los que la sesión web (cookie) puede llamar a /api (página "Consumo API").
# Incluya aquí el host:puerto exacto con el que abre la app.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,127.0.0.1,localhost
